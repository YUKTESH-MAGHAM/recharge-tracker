{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/icons/(.*)",
      "dest": "public/icons/$1"
    },
    {
      "src": "/manifest\\.json",
      "dest": "public/manifest.json"
    },
    {
      "src": "/sw\\.js",
      "dest": "public/sw.js"
    },
    {
      "src": "/style\\.css",
      "dest": "public/style.css"
    },
    {
      "src": "/app\\.js",
      "dest": "public/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
